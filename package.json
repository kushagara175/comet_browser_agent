{
  "name": "privapilot-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Comet — Privacy-Preserving On-Device Visual Perception for Lightweight Browser Agents (SIH26171 | ISRO)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test 'agent-harness/**/*.test.js'",
    "test:canary": "node scripts/test-proxy.js",
    "test:llm": "node --env-file-if-exists=.env scripts/test-local-llm.js",
    "benchmark": "node scripts/run-benchmarks.js",
    "verify:redaction": "node scripts/verify-redaction.mjs",
    "benchmark:browser": "node scripts/run-browser-benchmark.mjs",
    "compare:models": "node --env-file-if-exists=.env scripts/compare-models.mjs",
    "test:e2e": "node scripts/run-e2e-extension.mjs",
    "test:e2e:matrix": "node scripts/run-e2e-matrix.mjs",
    "validate:production": "node scripts/run-production-validation.mjs",
    "dev:server": "node --env-file-if-exists=.env apps/server/dist/index.js",
    "dev:portal": "node apps/demo-portal/server.js",
    "lint": "node scripts/typecheck.js && node scripts/check-repo-integrity.mjs"
  },
  "keywords": [
    "privacy",
    "browser-agent",
    "sih2026",
    "isro",
    "on-device-perception",
    "vlm"
  ],
  "author": "SIH26171 Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "border-beam": "^1.3.0",
    "ogl": "^1.0.11",
    "orbloom": "^0.1.0",
    "voice-glow": "^0.2.0"
  }
}
